<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Identity. CFBundleName/DisplayName are the literal product name; the
	     identifier and executable come from build settings so the project.yml
	     stays the single source of truth for the bundle id and target name. -->
	<key>CFBundleName</key>
	<string>dwanim it</string>
	<key>CFBundleDisplayName</key>
	<string>dwanim it</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>

	<!-- Bundle plumbing. APPL marks this as an application bundle; the version
	     keys carry the marketing (1.0) and build (1) numbers. -->
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>

	<!-- Platform + capabilities. Min macOS 14.0 (matches the SkinKit package
	     platform tier); Retina-aware; music category for the App Store. -->
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.music</string>

	<!-- App icon (the AppIcon.appiconset authored in increment #3). -->
	<key>CFBundleIconName</key>
	<string>AppIcon</string>

	<!-- SwiftUI App lifecycle: the default principal class is the standard
	     AppKit application. Stated explicitly so the generated bundle launches
	     as a normal NSApplication-hosted app rather than relying on an implicit
	     default. -->
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>

	<!-- Neutral MIT copyright line (no brand words, per §8.5/§8.6). -->
	<key>NSHumanReadableCopyright</key>
	<string>Released under the MIT License.</string>

	<!-- Export compliance. The app uses no encryption beyond what Apple's OS
	     provides (no custom crypto, no HTTPS — there is no network at all).
	     Declaring this here answers the export-compliance question up front, so
	     App Store Connect does NOT prompt for it on every build upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- Intentionally NO network usage keys: the app makes no network
	     connections. -->

	<!-- DOCUMENT TYPES — so "dwanim it" appears in Finder's right-click
	     "Open With" menu for the file kinds it can actually open, and a file
	     opened that way (or via `open -a`) is routed to the matching action by
	     the app's open-event handler (AppDelegate.application(_:open:)).
	     POLITE handler ranks: audio / playlists / .wsz are declared "Alternate"
	     so we appear in Open With WITHOUT hijacking the system defaults (Music
	     etc.); only our OWN theme files (.dwtheme / legacy .dwskin) are "Owner"
	     so double-clicking one opens us. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<!-- AUDIO. System-declared UTIs; the same concrete types the "Open
		     Audio…" panel accepts (mp3 / m4a-aac / raw-aac / wav / aiff / flac).
		     Viewer role (we play, never save the file); Alternate rank so Music
		     stays the default. -->
		<dict>
			<key>CFBundleTypeName</key>
			<string>Audio File</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.mp3</string>
				<string>public.mpeg-4-audio</string>
				<string>public.aac-audio</string>
				<string>com.microsoft.waveform-audio</string>
				<string>public.aiff-audio</string>
				<string>org.xiph.flac</string>
			</array>
		</dict>
		<!-- PLAYLIST (.m3u / .m3u8). References the imported type declared
		     below. Viewer role; Alternate rank. -->
		<dict>
			<key>CFBundleTypeName</key>
			<string>Audio Playlist</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.m3u-playlist</string>
			</array>
		</dict>
		<!-- OUR THEME FILES (.dwtheme + legacy .dwskin). References the EXPORTED
		     type declared below (our own format). Owner rank: double-clicking a
		     theme opens us. -->
		<dict>
			<key>CFBundleTypeName</key>
			<string>dwanim it Theme</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>tw.com.yuzhitech.dwanimit.theme</string>
			</array>
		</dict>
		<!-- WINAMP SKIN (.wsz). References the imported type declared below (NOT
		     our format — a zip archive). Viewer role; Alternate rank. -->
		<dict>
			<key>CFBundleTypeName</key>
			<string>Winamp Skin</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.nullsoft.winamp.skin</string>
			</array>
		</dict>
	</array>

	<!-- EXPORTED type — our OWN colour-theme format. Both extensions map to one
	     UTI. Conforms to public.text: a `.dwtheme` / `.dwskin` is UTF-8 text
	     (either JSON or `key: value` lines — see AppearanceParser), so `text`
	     is the honest supertype (it already conforms to public.data). -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>tw.com.yuzhitech.dwanimit.theme</string>
			<key>UTTypeDescription</key>
			<string>dwanim it Theme</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.text</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>dwtheme</string>
					<string>dwskin</string>
				</array>
			</dict>
		</dict>
	</array>

	<!-- IMPORTED types — formats OWNED BY OTHERS that we can open: the m3u
	     playlist (text) and the Winamp skin (a zip archive). Declared imported
	     (not exported) because they are not our formats. -->
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>public.m3u-playlist</string>
			<key>UTTypeDescription</key>
			<string>Audio Playlist</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.text</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>m3u</string>
					<string>m3u8</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.nullsoft.winamp.skin</string>
			<key>UTTypeDescription</key>
			<string>Winamp Skin</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>com.pkware.zip-archive</string>
				<string>public.zip-archive</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>wsz</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
