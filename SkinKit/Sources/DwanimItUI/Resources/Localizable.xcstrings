      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" isn't a readable theme. Needs keys like accent, bg1, panel."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」は読み込めるテーマではありません。accent、bg1、panel などのキーが必要です。"
